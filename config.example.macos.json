  "actions": {
    "finder": {
      "type": "app",
      "label": "Finder",
      "appid": "com.apple.finder"
    },
    "safari": {
      "type": "app",
      "label": "Safari",
      "appid": "com.apple.Safari"
    },
    "terminal": {
      "type": "app",
      "label": "Terminal",
      "appid": "com.apple.Terminal"
    },
    "notes": {
      "type": "app",
      "label": "Notes",
      "appid": "com.apple.Notes"
    },
    "calculator": {
      "type": "app",
      "label": "Calculator",
      "appid": "com.apple.calculator"
    },
    "activity": {
      "type": "app",
      "label": "Activity Monitor",
      "appid": "com.apple.ActivityMonitor"
    },
    "settings": {
      "type": "app",
      "label": "System Settings",
      "appid": "com.apple.systempreferences"
    },
    "downloads": {
      "type": "folder",
      "label": "Downloads",
      "path": "~/Downloads"
    },
    "youtube": {
      "type": "url",
      "label": "YouTube",
      "url": "https://www.youtube.com",
      "icon": "▶️",
      "color": "#ff0033"
    },
    "github": {
      "type": "url",
      "label": "GitHub",
      "url": "https://github.com",
      "icon": "🐙",
      "color": "#24292f"
    },
    "teams-mute": {
      "type": "keys",
      "label": "Mute Teams",
      "keys": "cmd+shift+m",
      "icon": "🎙️",
      "color": "#5b5fc7"
    },
    "snip": {
      "type": "keys",
      "label": "Screenshot",
      "keys": "cmd+shift+4",
      "icon": "✂️"
    },
    "spotlight": {
      "type": "keys",
      "label": "Spotlight",
      "keys": "cmd+space",
      "icon": "🔍"
    },
    "mission-control": {
      "type": "keys",
      "label": "Mission Control",
      "keys": "ctrl+up",
      "icon": "🗂️"
    },
    "emoji": {
      "type": "keys",
      "label": "Emoji",
      "keys": "ctrl+cmd+space",
      "icon": "😀"
    },
    "copy": {
      "type": "keys",
      "label": "Copy",
      "keys": "cmd+c",
      "icon": "📋"
    },
    "paste": {
      "type": "keys",
      "label": "Paste",
      "keys": "cmd+v",
      "icon": "📥"
    },
    "play-pause-key": {
      "type": "keys",
      "label": "Play / Pause",
      "keys": "media_play_pause",
      "icon": "⏯️"
    },
    "signature": {
      "type": "text",
      "label": "Signature",
      "text": "Best regards,\nYour Name",
      "icon": "✍️"
    },
    "open-textedit-macro": {
      "type": "steps",
      "label": "TextEdit via Spotlight",
      "icon": "📝",
      "steps": [
        {
          "keys": "cmd+space"
        },
        {
          "delay": 0.5
        },
        {
          "text": "TextEdit"
        },
        {
          "delay": 0.3
        },
        {
          "keys": "enter"
        }
      ]
    }
  }
}